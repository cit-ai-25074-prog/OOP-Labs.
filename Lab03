// main
// ============================================================
int main()
{
    srand(time(0)); // seed for random item codes

    int choice;
    cout << "LAB-03\n1) Task 01 (Part 1)\n2) Task 01 (Part 2)\n3) Task 02\nChoose: ";
    cin >> choice;

    switch (choice)
    {
    case 1: task01_part1(); break;
    case 2: task01_part2(); break;
    case 3: task02(); break;
    default: cout << "Invalid choice." << endl;
    }
    return 0;
}
